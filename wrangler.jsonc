{
  "name": "tini-fanpage",
  "main": "servidor.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bd-general",
      "database_id": "8494cda9-4a0b-4a41-a920-e8efdc845c3a"
    }
  ]
}
